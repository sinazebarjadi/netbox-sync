# Copy this file to `.env` and fill in your real values.
# NEVER commit the real `.env` file to git.

# =============================================================================
# NetBox (target)
# =============================================================================
NETBOX_URL=https://netbox.example.com
NETBOX_TOKEN=changeme-netbox-api-token
# Verify NetBox's TLS certificate. Keep false for self-signed certs.
NETBOX_VERIFY_TLS=false

# =============================================================================
# ManageEngine AssetExplorer (offline/inventory asset source, opt-in)
# Syncs AE assets (with serial + mapped product type) that are NOT in NetBox.
# Matches by serial; never touches discovery-managed devices.
# =============================================================================
# AE_URL=https://assetexplorer.example.local
# AE_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# =============================================================================
# Scan ranges
# Comma-separated CIDR ranges to scan per family.
# Set a range EMPTY (e.g. BMC_RANGES=) to disable that family entirely —
# no scanning and no offline marking for it.
# =============================================================================
BMC_RANGES=192.0.2.0/27,198.51.100.0/27
STORAGE_RANGES=192.0.2.16/32,198.51.100.16/32
SAN_RANGES=192.0.2.32/29,198.51.100.32/29
# CISCO_RANGES=192.0.2.64/29
# FORTIGATE_RANGES=192.0.2.96/29
# FORTIWEB_RANGES=192.0.2.252/32
# FMC_RANGES=192.0.2.143/32
# RUCKUS_RANGES=192.0.2.100/32
# UNIFI_RANGES=192.0.2.67/32
# HIKVISION_RANGES=192.0.2.120/32
# DAHUA_RANGES=192.0.2.130/32
# UNV_RANGES=192.0.2.140/32

# =============================================================================
# Servers — Redfish / iLO (BMC)
# =============================================================================
REDFISH_USER=changeme
REDFISH_PASS=changeme
REDFISH_PORT=443

# =============================================================================
# Storage — HPE MSA (XML API)
# =============================================================================
STORAGE_USER=changeme
STORAGE_PASS=changeme
STORAGE_PORT=443
STORAGE_AUTH_HASH=sha256

# =============================================================================
# SAN switches — Brocade / HPE B-Series (SSH CLI)
# =============================================================================
SWITCH_USER=changeme
SWITCH_PASS=changeme
SWITCH_PORT=22
# Verify switch SSH host keys against the system known_hosts (MITM protection)
SWITCH_STRICT_HOST_KEY=false

# =============================================================================
# LAN switches — Cisco Catalyst (IOS / IOS-XE, SSH via netmiko)
# Also enables camera->switch cabling (MAC-table lookup) when HIKVISION_RANGES is set
# =============================================================================
CISCO_USER=changeme
CISCO_PASS=changeme
CISCO_PORT=22
DEFAULT_CISCO_ROLE=Switch

# =============================================================================
# Firewalls — FortiGate (REST session + SSH extras)
# =============================================================================
FORTIGATE_USER=changeme
FORTIGATE_PASS=changeme
FORTIGATE_PORT=443
FORTIGATE_SSH_PORT=22
DEFAULT_FORTIGATE_ROLE=Firewall

# =============================================================================
# WAFs — FortiWeb (REST API, base64-token auth)
# Reuses FORTIGATE_USER/PASS unless you set FORTIWEB_USER/PASS explicitly.
# =============================================================================
# FORTIWEB_USER=changeme
# FORTIWEB_PASS=changeme
FORTIWEB_PORT=58291
DEFAULT_FORTIWEB_ROLE=WAF

# =============================================================================
# Firewalls - Cisco FTD via FMC (REST API, token auth)
# Each FMC_RANGES IP is an FMC appliance; its managed FTDs are imported.
# =============================================================================
FMC_USER=changeme
FMC_PASS=changeme
FMC_PORT=443
DEFAULT_FTD_ROLE=FTD

# =============================================================================
# Wireless — Ruckus ZoneDirector (SSH interactive shell)
# =============================================================================
RUCKUS_USER=changeme
RUCKUS_PASS=changeme
RUCKUS_PORT=22
# Optional HA pairs: "vip:primary,secondary" per pair, pairs separated by ";"
# RUCKUS_HA_MAP=192.0.2.100:192.0.2.101,192.0.2.102
DEFAULT_RUCKUS_ROLE=Wireless Controller

# =============================================================================
# Wireless — Ubiquiti UniFi OS consoles (HTTPS session API)
# =============================================================================
UNIFI_USER=changeme
UNIFI_PASS=changeme
UNIFI_PORT=8443
DEFAULT_UNIFI_ROLE=Wireless Controller
DEFAULT_AP_ROLE=Access Point

# =============================================================================
# NVRs — Hikvision (ISAPI, HTTP digest)
# =============================================================================
HIKVISION_USER=changeme
HIKVISION_PASS=changeme
HIKVISION_PORT=80
DEFAULT_HIKVISION_ROLE=NVR
# Also used for Dahua/Uniview cameras (the Camera role is vendor-neutral)
DEFAULT_HIKVISION_CAMERA_ROLE=Camera

# =============================================================================
# NVRs — Dahua (CGI, HTTP digest)
# =============================================================================
DAHUA_USER=changeme
DAHUA_PASS=changeme
DAHUA_PORT=80
DEFAULT_DAHUA_ROLE=NVR

# =============================================================================
# NVRs — Uniview / UNV (LAPI, HTTP digest)
# =============================================================================
UNV_USER=changeme
UNV_PASS=changeme
UNV_PORT=80
DEFAULT_UNV_ROLE=NVR

# =============================================================================
# Site mapping
# =============================================================================
# Optional: comma-separated "keyword:SiteName" pairs, e.g. "dc1:Datacenter1,hq:HQ"
SITE_KEYWORD_MAP=site1:Site1,site2:Site2
# Optional: comma-separated "cidr:SiteName" pairs, checked BEFORE SITE_KEYWORD_MAP.
# Longest prefix wins. e.g. "172.31.0.0/16:HQ,172.31.1.0/24:Branch-F10"
# SITE_IP_MAP=192.0.2.0/27:Site1,198.51.100.0/27:Site2

# =============================================================================
# Misc
# =============================================================================
SCAN_WORKERS=20
# Consecutive scans a device must miss before it is marked offline (anti-flapping)
OFFLINE_THRESHOLD=2
# Log verbosity: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO
DEFAULT_SITE_NAME=Default
DEFAULT_ROLE_NAME=Server
DEFAULT_STORAGE_ROLE=Storage
DEFAULT_SWITCH_ROLE=SAN Switch
