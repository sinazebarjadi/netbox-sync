# NetBox MCP server environment template
# NEVER commit a real file with these values. Copy to .env and fill in.
# The token must be read-only: write_enabled=False (ObjectPermission: view only).

# NetBox base URL — fill in YOUR NetBox host. Do NOT commit a real address.
NETBOX_URL=https://<netbox-host-or-ip>
# Read-only NetBox v2 API token (full credential: nbt_<key>.<plaintext>)
# ___ PASTE FULL TOKEN HERE ___
NETBOX_TOKEN=
# "false" for self-signed certs on private networks; "true" if CA-signed
NETBOX_VERIFY_TLS=false
# SSE transport host/port for the MCP server itself
MCP_HOST=127.0.0.1
MCP_PORT=8901
